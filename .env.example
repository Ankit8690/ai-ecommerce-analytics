# Copy this file to .env and fill in real values. Never commit .env.
# All connection strings use the psycopg v3 driver ("postgresql+psycopg://").

# --- PostgreSQL: application user (read + write) ---
# Required for normal schema initialization, loading and application writes.
# This must use ecommerce_app and target ecommerce_ai; never use postgres here.
DATABASE_URL=postgresql+psycopg://ecommerce_app:CHANGE_ME@localhost:5432/ecommerce_ai

# --- PostgreSQL: read-only user (SELECT only) ---
# Required for verification and, later, the LLM natural-language-to-SQL path.
DATABASE_URL_READONLY=postgresql+psycopg://ecommerce_readonly:CHANGE_ME@localhost:5432/ecommerce_ai

# --- PostgreSQL: superuser admin URL ---
# Required only for `python database/seed.py --bootstrap`. It creates the
# dedicated roles and grants limited access to the already-created ecommerce_ai
# database; it never creates or drops a database.
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/postgres

# Required only by --bootstrap to create or rotate the dedicated role passwords.
# Keep them in sync with the URLs above. Never use a postgres-superuser password.
APP_DB_PASSWORD=CHANGE_ME
READONLY_DB_PASSWORD=CHANGE_ME

# --- Path to the raw CSV directory (extracted from archive (4).zip) ---
DATASET_RAW_DIR=Dataset/raw

# --- AI Analyst / LLM configuration (Phase 6) ---
# Set LLM_API_KEY to your Google AI Studio key (https://aistudio.google.com/).
# GEMINI_API_KEY is accepted as a compatibility alias; LLM_API_KEY takes priority.
# LLM_MODEL selects the Gemini model — leave blank to use the default (gemini-2.5-flash).
# Never commit real keys. Keep them in .env only.
LLM_PROVIDER=google-gemini
LLM_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
